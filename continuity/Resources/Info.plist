<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key><string>en</string>
  <key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
  <key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
  <key>CFBundleName</key><string>$(PRODUCT_NAME)</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>$(MARKETING_VERSION)</string>
  <key>CFBundleVersion</key><string>$(CURRENT_PROJECT_VERSION)</string>
  <key>LSMinimumSystemVersion</key><string>$(MACOSX_DEPLOYMENT_TARGET)</string>
  <!-- The whole app is a menu bar item: no window, no Dock tile, no launch focus
       steal. Declared here rather than by setActivationPolicy(.accessory) at
       runtime, which shows a Dock icon for the moment before it runs. -->
  <key>LSUIElement</key><true/>
  <key>LSApplicationCategoryType</key><string>public.app-category.utilities</string>
  <!-- Sparkle. The feed is the appcast.xml committed at the root of this repo,
       served raw by GitHub — a fixed URL that costs nothing to host and that
       `just publish` rewrites and pushes on every release. It must stay reachable
       for as long as any copy is installed, so it is deliberately not tied to a
       release tag or an asset id, both of which move.
       SUPublicEDKey is the public half of the EdDSA key in the login keychain —
       the same key utt signs with. Lose the private half and no installed copy
       can ever be updated again. -->
  <key>SUFeedURL</key><string>https://raw.githubusercontent.com/doublej/continuity/main/appcast.xml</string>
  <key>SUPublicEDKey</key><string>3f8pu0IeVTScmSSV33gb09yrNFct0DxKX72KrDLkDEY=</string>
  <!-- Checks itself daily from first launch, without Sparkle's "may I check?"
       prompt. Installing still asks: SUAutomaticallyUpdate stays off, so nothing
       is swapped in underneath a call. -->
  <key>SUEnableAutomaticChecks</key><true/>
  <key>SUScheduledCheckInterval</key><integer>86400</integer>
</dict>
</plist>
